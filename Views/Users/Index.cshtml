@model IReadOnlyCollection<AppUser>
@{
    ViewData["Title"] = "User List";
}

<section class="card premium">
    <div class="section-header">
        <div>
            <h2>User Management</h2>
            <p class="muted">Create, edit, disable users and assign roles.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">Add User</a>
    </div>

    @if (TempData["LoginSuccess"] is string successMessage)
    {
        <div class="alert success">@successMessage</div>
    }

    <div class="table-wrap">
        <table>
            <thead>
            <tr>
                <th>UserName</th>
                <th>Email</th>
                <th>Role</th>
                <th>Status</th>
                <th>Created By / Date</th>
                <th>Modified By / Date</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.UserName</td>
                    <td>@user.Email</td>
                    <td><span class="role-pill">@user.Role</span></td>
                    <td>
                        @if (user.IsActive)
                        {
                            <span class="status-pill active">Active</span>
                        }
                        else
                        {
                            <span class="status-pill disabled">Disabled</span>
                        }
                    </td>
                    <td>@user.CreatedBy<br /><span class="muted">@user.CreatedDate.ToString("u")</span></td>
                    <td>@user.ModifiedBy<br /><span class="muted">@user.ModifiedDate.ToString("u")</span></td>
                    <td class="actions-cell">
                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-outline">Edit</a>
                        <form asp-action="ToggleStatus" asp-route-id="@user.Id" method="post" class="inline-form">
                            <button type="submit" class="btn btn-ghost">@(user.IsActive ? "Disable" : "Enable")</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
