@model LoginRequest
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Secure Login";
}

<section class="card auth-card premium">
    <div class="auth-card-head">
        <h2>Secure Login</h2>
        <span class="chip">JWT Enabled</span>
    </div>
    <p class="muted auth-subtitle">Sign in with Username/Email and Password.</p>

    @if (TempData["LogoutSuccess"] is string logoutMessage)
    {
        <div class="alert success">@logoutMessage</div>
    }

    <form asp-action="Login" method="post" class="auth-form-grid">
        <div asp-validation-summary="ModelOnly" class="alert error"></div>

        <div class="auth-field">
            <label asp-for="UserNameOrEmail">Username / Email</label>
            <input asp-for="UserNameOrEmail" placeholder="admin or admin@pdfcompare.local" required />
        </div>

        <div class="auth-field">
            <label asp-for="Password">Password</label>
            <input asp-for="Password" type="password" placeholder="••••••••" required />
        </div>

        <button type="submit" class="btn btn-primary auth-submit">Login</button>
    </form>

    <p class="note auth-note">
        Demo users: <strong>admin</strong> / <strong>Admin@123</strong> and
        <strong>reviewer</strong> / <strong>Reviewer@123</strong>.
    </p>
</section>
