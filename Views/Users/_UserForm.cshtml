@model UserUpsertRequest
@{
    var isEdit = (ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty) == "Edit";
}

<form method="post" class="user-form">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert error"></div>

    <div class="user-form-grid">
        <div class="user-field">
            <label asp-for="UserName">User Name</label>
            <input asp-for="UserName" required />
            <span asp-validation-for="UserName" class="field-error"></span>
        </div>

        <div class="user-field">
            <label asp-for="Email">Email</label>
            <input asp-for="Email" type="email" required />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>

        <div class="user-field">
            <label asp-for="Password">Password <span class="muted">@(isEdit ? "(leave blank to keep current)" : "(required for create)")</span></label>
            <input asp-for="Password" type="password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <div class="user-field">
            <label asp-for="Role">Role</label>
            <select asp-for="Role" asp-items="Html.GetEnumSelectList<UserRole>()"></select>
            <span asp-validation-for="Role" class="field-error"></span>
        </div>
    </div>

    <label class="checkbox-row user-active-row">
        <input asp-for="IsActive" type="checkbox" />
        <span>Active account</span>
    </label>

    <div class="form-actions user-form-actions">
        <button type="submit" class="btn btn-primary">Save User</button>
        <a asp-action="Index" class="btn btn-outline">Cancel</a>
    </div>
</form>
